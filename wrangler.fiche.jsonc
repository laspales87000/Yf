// Deuxième petit site PUBLIC, sans protection : il ne contient QUE la page « fiche seule » (fiche.html).
// Chez Cloudflare : Worker « suivi-fiches », Root directory « / » (vide) et
// Deploy command : npx wrangler deploy -c wrangler.fiche.jsonc
// La page est copiée depuis fiche.html à chaque mise en ligne : il n'y a qu'un seul original.
// Pour relancer une mise en ligne avec de nouveaux réglages, il faut un nouvel envoi : « Retry build » reprend les anciens.
{
  "name": "suivi-fiches",
  "compatibility_date": "2025-11-01",
  "build": { "command": "rm -rf .fiche && mkdir .fiche && cp fiche.html .fiche/fiche.html" },
  "assets": { "directory": "./.fiche", "not_found_handling": "none" }
}
